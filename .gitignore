.DS_Store
Thumbs.db

# Business data with its own backup mechanism (apps/server/backup.ts writes
# these to BACKUP_DIR on a schedule) — kept out of git so the repo stays a
# record of the *code*, not a growing pile of database dumps and photos.
apps/server/uploads/
apps/server/backups/
apps/server/logs/

# The trimmed PostgreSQL engine the installer ships with. Re-fetched on demand
# by apps/desktop/scripts/fetch-postgres.mjs — ~60 MB of third-party binaries
# that would bloat the repo for no benefit.
apps/desktop/vendor/

# The private half of the license-signing keypair, and the record of who has
# been issued a key. Never shipped, never committed — see
# scripts/generate-license-keypair.mjs. Only the public key (a short string
# pasted into apps/desktop/src/main/license.ts) is meant to leave this machine.
license-private-key.pem
/licenses/
