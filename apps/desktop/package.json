{
  "name": "@pharmacy/desktop",
  "version": "0.1.0",
  "description": "نظام إدارة الصيدلية — تطبيق سطح المكتب",
  "author": "Pharmacy System",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -b && vite build && npm run build:backend && electron-builder",
    "build:backend": "npm run build --workspace=@pharmacy/server && node scripts/bundle-server.mjs && node scripts/fetch-postgres.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "build:icon": "node scripts/build-icon.mjs"
  },
  "build": {
    "appId": "com.pharmacy-system.desktop",
    "productName": "نظام إدارة الصيدلية",
    "artifactName": "pharmacy-system-setup-${version}.${ext}",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "vendor/pgsql",
        "to": "pgsql"
      },
      {
        "from": "build-resources/server",
        "to": "server"
      },
      {
        "from": "../server/prisma/migrations",
        "to": "prisma/migrations"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "dependencies": {
    "@pharmacy/shared-types": "*",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "electron-store": "^11.0.2",
    "i18next": "^23.16.5",
    "jimp": "^1.6.1",
    "lucide-react": "^0.454.0",
    "node-thermal-printer": "^4.6.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9"
  }
}
