# انسخ هذا الملف إلى .env وعدّل القيم أدناه.

# اتصال قاعدة بيانات التطوير/الإنتاج.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy?schema=public"

# قاعدة بيانات منفصلة تستخدمها الاختبارات فقط — لا تُشِر إلى قاعدة التطوير هنا،
# فالاختبارات قد تمسح بياناتها.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/pharmacy_test?schema=public"

# مفتاح توقيع الجلسات — 32 حرفاً على الأقل، ومختلف عن هذه القيمة الافتراضية،
# وإلا يرفض الخادم الإقلاع. لتوليد قيمة عشوائية صالحة:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-change-me-change-me-change-me"

# مدة صلاحية جلسة الدخول.
JWT_EXPIRES_IN="12h"

# المنفذ الذي يستمع عليه الخادم.
PORT=3000

# مجلد النسخ الاحتياطية — اضبطه على قرص خارجي عند التسليم للعميل؛ نسخة
# احتياطية على نفس القرص لا تنفع إذا تلف القرص نفسه.
BACKUP_DIR="./backups"

# كم نسخة احتياطية تُحفظ قبل حذف الأقدم.
BACKUP_RETENTION=14
